def display_maze(maze, player_row, player_col, goal_row, goal_col,visible_rad=None):
    for r in range(len(maze)):
        line = ""
        for c in range(len(maze[0])):
            if visible_rad is not None and max(abs(r-player_row), abs(c-player_col)) > visible_rad:
                line += "? "
                continue
            if r == player_row and c == player_col:
                line += "P "
            elif r == goal_row and c == goal_col:
                line += "G "
            elif maze[r][c] == 1:
                line += "# "
            else:
                line += "  "
        print(line)
        
        

    


def player_movement(move, maze, player_row, player_col):
    moves = { "w": (-1, 0), "a": (0, -1), "s": (1, 0), "d"
             : (0, 1) }
    if move not in moves: return None 
    dr, dc = moves[move] 
    new_r = player_row + dr 
    new_c = player_col + dc 
    if (new_r <= 0 or new_c <= 0 or new_r >= len(maze) - 1 or new_c >= len(maze[0]) - 1):
        return None 
    if maze[new_r][new_c] == 1:
        return None
    return new_r, new_c

def main(): 
    rows = 31
    cols = 31
    maze,correct_path = generate_maze(rows, cols) 
    player_row = 1 
    player_col = 1 
    goal_row = rows - 2 
    goal_col = cols - 2 
    moves_made = 0 
    while True: 
        print("\033[H\033[J", end="") 
        print("===== MAZE GAME =====") 
        print("W = Up | A = Left | S = Down | D = Right") 
        print() 
        display_maze( maze, player_row, player_col, goal_row, goal_col ) 
        print() 
        print("Moves:", moves_made) 
        if player_row == goal_row and player_col == goal_col: 
            print() 
            print("YOU WON!") 
            print("Total moves:", moves_made) 
            break 
        move = input("Enter your move: ").lower() 
        result = player_movement( move, maze, player_row, player_col ) 
        if result is None: 
            print() 
            print("Invalid move!") 
            print("GAME OVER") 
            break 
        player_row, player_col = result 
        moves_made += 1
        
        



main()
