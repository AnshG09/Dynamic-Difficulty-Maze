import random

def generate_maze(row,col):
    maze=[[1 for x in range(col)] for y in range(row)]
    def path(r,c):
        maze[r][c]=0
        direction=[
            (-2,0),
            (2,0),
            (0,-2),
            (0,2)
        ]
        random.shuffle(direction)
        for dir_row,dir_col in direction:
            new_r=r+dir_row
            new_c=c+dir_col
            if 0<new_r<row-1 and 0<new_c<col-1:
                if maze[new_r][new_c]==1:
                    maze[r+dir_row//2][c+dir_col//2] = 0
                    path(new_r,new_c)
    correct_path = []
    
    visitedCell = [[False for _ in range(col)] for _ in range(row)]

    def correctPath(r, c):
        if (r, c) == (row - 2, col - 2):
            correct_path.append((r, c))
            return True
        if maze[r][c] == 1 or visitedCell[r][c]:
            return False
        visitedCell[r][c]=True
        if (correctPath(r + 1, c) or correctPath(r - 1, c) or
                correctPath(r, c + 1) or correctPath(r, c - 1)):
            correct_path.append((r, c))
            return True
        return False
    
    path(1,1)
    correctPath(1,1)
    print(correct_path)
    return(maze,correct_path)

